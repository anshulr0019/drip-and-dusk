# Copy to .dev.vars locally. Never put these values in dist/ or commit real keys.
COMMERCE_MODE=manual_demo
PUBLIC_ORIGIN=http://127.0.0.1:4173
TRACKING_SECRET=replace-with-at-least-32-random-characters
ADMIN_SECRET=replace-with-a-different-32-character-random-secret
# Optional: connect merchant-owned TEST credentials to enable Razorpay alongside the manual sample.
# Leave empty to keep Razorpay visibly awaiting setup. Never use live keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Explicit, merchant-approved test rates in paise; no implicit pan-India promise.
SHIPPING_RULES_JSON={"zones":[{"prefixes":["411"],"feePaise":9900,"label":"Test Pune delivery"}],"freeAbovePaise":300000}
# Optional courier bridge, configured only after choosing a provider.
COURIER_WEBHOOK_SECRET=
# Optional direct Meta integration. Requires approved template and test recipient.
ALLOW_SANDBOX_MESSAGES=false
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE=drip_dusk_order_confirmed
WHATSAPP_LANGUAGE=en
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional managed customer/owner accounts. Real login stays disabled until set.
AUTH_PROVIDER=supabase
# Enable Google only after configuring the provider and callback URLs.
AUTH_GOOGLE_ENABLED=false
AUTH_EMAIL_ENABLED=true
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace
AUTH_SESSION_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
# Verified Supabase user UUIDs, set by the store operator. Never read roles from user metadata.
AUTH_OWNER_IDS=
