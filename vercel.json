{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/commerce-config\\.mjs",
      "dest": "https://drip-and-dusk-checkout.drip-and-dusk.workers.dev/commerce-config.mjs",
      "headers": {
        "Cache-Control": "no-store",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/(catalogue|config)",
      "dest": "https://drip-and-dusk-checkout.drip-and-dusk.workers.dev/api/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://drip-and-dusk-checkout.drip-and-dusk.workers.dev/api/$1",
      "headers": {
        "Cache-Control": "no-store",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store"
      }
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "/(privacy|terms|refunds|shipping|contact)/?",
      "dest": "/policies/$1.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
