{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'",
        "X-Frame-Options": "DENY",
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
      },
      "continue": true
    },
    {
      "src": "/commerce-config\\.mjs",
      "dest": "https://drip-and-dusk-checkout.drip-and-dusk.workers.dev/commerce-config.mjs",
      "headers": {
        "Cache-Control": "no-store",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store"
      }
    },
    {
      "src": "/api/(catalogue|config)",
      "dest": "https://drip-and-dusk-checkout.drip-and-dusk.workers.dev/api/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "https://drip-and-dusk-checkout.drip-and-dusk.workers.dev/api/$1",
      "headers": {
        "Cache-Control": "no-store",
        "CDN-Cache-Control": "no-store",
        "Vercel-CDN-Cache-Control": "no-store"
      }
    },
    {
      "src": "/media/(.*)",
      "dest": "https://drip-and-dusk-checkout.drip-and-dusk.workers.dev/media/$1"
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "/(privacy|terms|refunds|shipping|contact)/?",
      "dest": "/policies/$1.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
